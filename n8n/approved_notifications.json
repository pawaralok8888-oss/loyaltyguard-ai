{
  "name": "LoyaltyGuard — Approved Notifications",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "poll-trigger-001",
      "name": "Poll every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.LOYALTYGUARD_BASE_URL }}/api/alerts?status=approved",
        "options": {
          "timeout": 10000
        }
      },
      "id": "get-approved-001",
      "name": "GET approved alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-approved-001",
      "name": "IF any approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "splitInBatches",
        "batchSize": 1
      },
      "id": "split-batches-001",
      "name": "Split into individual alerts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.LOYALTYGUARD_BASE_URL }}/api/alerts/{{ $json.id }}/send",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-alert-001",
      "name": "POST /api/alerts/{id}/send (idempotent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 200],
      "notes": "This endpoint is idempotent — calling it multiple times for the same proposal only sends once. The response includes is_newly_sent to distinguish first send from duplicates. n8n NEVER auto-approves; approval is human-only via the UI."
    },
    {
      "parameters": {
        "operation": "log",
        "message": "=Alert {{ $json.id }} send result: is_newly_sent={{ $json.is_newly_sent }}. Status={{ $json.proposal.status }}"
      },
      "id": "log-send-001",
      "name": "Log send result",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "operation": "log",
        "message": "No approved alerts to send at {{ $now.toISO() }}"
      },
      "id": "log-none-001",
      "name": "Log none",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Poll every 5 minutes": {
      "main": [
        [{"node": "GET approved alerts", "type": "main", "index": 0}]
      ]
    },
    "GET approved alerts": {
      "main": [
        [{"node": "IF any approved", "type": "main", "index": 0}]
      ]
    },
    "IF any approved": {
      "main": [
        [{"node": "Split into individual alerts", "type": "main", "index": 0}],
        [{"node": "Log none", "type": "main", "index": 0}]
      ]
    },
    "Split into individual alerts": {
      "main": [
        [{"node": "POST /api/alerts/{id}/send (idempotent)", "type": "main", "index": 0}]
      ]
    },
    "POST /api/alerts/{id}/send (idempotent)": {
      "main": [
        [{"node": "Log send result", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "loyaltyguard-n8n-approved-notifications"
  }
}
