# LoyaltyGuard AI Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev / Render free tier with persistent disk)
DATABASE_URL=sqlite:///./loyaltyguard.db
# PostgreSQL example (Railway / Render paid):
# DATABASE_URL=postgresql://user:password@host:5432/loyaltyguard

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# ── Security ──────────────────────────────────────────────────────────────────
# Change to a long random string; use the same value in n8n credential
N8N_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── Mock portal ───────────────────────────────────────────────────────────────
# Base URL of the mock portal endpoints (same service in this single-service deploy)
PORTAL_BASE_URL=https://YOUR_RENDER_OR_RAILWAY_URL

# Set to "true" ONLY in local development to enable /mock/admin/* endpoints.
# Leave unset or "false" in production.
MOCK_ADMIN_ENABLED=false

# ── LLM (optional) ───────────────────────────────────────────────────────────
# Leave LLM_PROVIDER=fallback if you have no key — the deterministic planner
# is used. Set to "openai" | "anthropic" | "gemini" and provide the key below.
LLM_PROVIDER=fallback
LLM_API_KEY=

# ── Clock override (testing only) ─────────────────────────────────────────────
# Leave blank in production
FROZEN_DATETIME=
