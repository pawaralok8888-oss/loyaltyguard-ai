{
  "name": "LoyaltyGuard — Daily Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "schedule-trigger-001",
      "name": "Schedule Trigger (06:00 daily)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.LOYALTYGUARD_BASE_URL }}/api/checks/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shared-Secret",
              "value": "={{ $credentials.LoyaltyGuardSharedSecret.value }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-checks-run-001",
      "name": "POST /api/checks/run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "loyaltyguard-shared-secret",
          "name": "LoyaltyGuard Shared Secret"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-failure-001",
      "name": "IF failure",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "log",
        "message": "=LoyaltyGuard daily check FAILED at {{ $now.toISO() }}. Status: {{ $json.statusCode }}. Body: {{ JSON.stringify($json.body) }}"
      },
      "id": "log-failure-001",
      "name": "Log failure",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "operation": "log",
        "message": "=LoyaltyGuard daily check OK at {{ $now.toISO() }}. Accounts checked: {{ $json.body.length }}"
      },
      "id": "log-success-001",
      "name": "Log success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Schedule Trigger (06:00 daily)": {
      "main": [
        [{"node": "POST /api/checks/run", "type": "main", "index": 0}]
      ]
    },
    "POST /api/checks/run": {
      "main": [
        [{"node": "IF failure", "type": "main", "index": 0}]
      ]
    },
    "IF failure": {
      "main": [
        [{"node": "Log failure", "type": "main", "index": 0}],
        [{"node": "Log success", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "loyaltyguard-n8n-daily-monitor"
  }
}
